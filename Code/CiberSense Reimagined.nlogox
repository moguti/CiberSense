<?xml version="1.0" encoding="utf-8"?>
<model version="NetLogo 7.0.3" snapToGrid="true">
  <code><![CDATA[extensions [ bspace ]
globals [
                                                           ; base-risk   riesgo base de caer en fraude (deslizador)
                                                           ; decay-rate  tasa de olvido por tick sin recibir aprendizaje (deslizador)
                                                           ; training-share porcentaje de la población a la que impacta la formación (deslizador)
                                                           ; n-attackers número de atacantes que habrá en el sistema (deslizador)
                                                           ; max-attempts-per-attacker tope máximo de intento por atacante y tick (deslizador)
                                                           ; attacker-learning-rate velocidad a la que cambia el esfuerzo por aprendizaje del atacante (deslizador)
                                                           ; p-detection define la probabilidad de detección de los ataques por parte de la policía (deslizador)
                                                           ; jail-time define la duración de la condena, es decir, cuanto tiempo estarán en la carcel los atacantes pillados por la policía
  experience-gain-small                                    ; aprendizaje pequeño al detectar amenaza y no caer
  experience-gain-large                                    ; aprendizaje grande al caer en fraude
  total-victims                                            ; son las víctimas agregadas por cada tick
  cumulative-victims                                       ; son las víctimas agregadas de manera acumulada
  attack-this-tick                                         ; representa el número de ataques en cada tick
  learning-quality                                         ; learning-quality  eficacia de la formación 
                                                           ;awareness-intensity: variable para modular el impacto de la sensibilización (deslizador)
                                                           ; training-intensity: variable para modular el impacto de la formación (deslizador)
  ema-success-rate                                         ; variable para calcular la media movil de la tasa de éxito y pintarla mejor
  ema-alpha                                                ; variable para definir la media movil que emplearemos para pintar la tasa de éxito
  base-payoff-per-success                                  ; befeneficio por víctima lograda
  cost-per-attempt                                         ; coste de cada intento
  attempts-per-tick                                        ; total de intentos lanzado por todos los atacantes por tick
  success-per-tick                                         ; total de éxitos logrados por todos los ataca 
  ticks-since-last-attack                                  ; cuantos ticks han pasado desde el último ataquentes por tick 
]

breed [citizens citizen]   ; agente ciudadano

citizens-own [
  digital-knowledge                                        ; conocimiento digital de los ciudadanos, irá de 0 (analfabeto digital) a 100 (experto digital)
  victim                                                   ; representa a las víctimas: si el ciudadano ha sufrido un ataque en este tick
  exposure                                                 ; número de ataques recibidos
  had-attempt-this-tick                                    ; pregunta si ha habido un intento de ataque en ese ciclo
]

breed [attackers attacker] ; agente delincuente

attackers-own [
  effort                                                   ; intensidad de los ataques (de 0 a 1) controla cuantos intentos lanza el atacante por tick
  attempts                                                 ; intentos en cada tick de este atacante
  successes                                                ; éxitos en cada tick de este atacante
  last-payoff                                              ; Beneficio neto de este atacante en ese tick
  aspiration-payoff                                        ; nivel de beneficio que el atacante considera aceptable, modulará el esfuerzo del atacante
  payoff-prev                                              ; beneficio de este atacante en el tick anterior
  jail-until                                               ; es el momento en el que cada atacante encarcelado sale de la carcel
]

to setup
  clear-all
  set-default-parameters
  setup-citizens
  setup-attackers
  reset-ticks
end

to set-default-parameters
  set base-risk 0.2                                         ; riesgo base
  set learning-quality 1                                    ; calidad del aprendizaje
  ;set awareness-frecuency 1000
  ;set train-frecuency 1000
  set experience-gain-small 0.1                            ; experiencia ganada si el ciudadano detecta un ataque sin caer
  set experience-gain-large 5                               ; experiencia ganada si el ciudadano cae en un fraude
  set decay-rate 0.05                                       ; tasa de olvido de conocimientos digitales de los ciudadanos
  set cumulative-victims 0                                  ; victimas acumuladas a 0 de inicio
 ; set training-shares 0.2                                   ; porcentaje del 20% de la población para las formaciones especializadas
 ; set max-attempts-per-attacker 6                            máximos intentos por atacante en cada ciclo
 ; set attacker-learning-rate 0.05                           ; tasa de aprendizaje de los atacantes del 5%
  set base-payoff-per-success 20                            ; beneficio base por éxito 
  set cost-per-attempt 4                                    ; coste por cada intento
  set attempts-per-tick 0                                   ; intentos por ciclo a 0 al inicio       
  set success-per-tick 0                                    ; éxito de atacante a 0 al inicio
  ; set awareness-intensity 0.2                             intensidad de la sensibilización a toda la población
  ;set training-intensity 1.6                               intensidad de la formación especialista
  set ema-success-rate 0                                    ; parámetros para suavizar la tasa de éxito con media movil
  set ema-alpha 0.02                                        ; parámetros para suavizar la tasa de éxito con media movil
  ;set p-detection 0.05                                      ; probabilidad de detección de los atacantes por parte de la policía de un 5%
  ;set jail-time 100                                         ; tiempo de encarcelamiento de 100 ciclos
  set ticks-since-last-attack 0                             ; al inicio no hay ataques y esta variable debe estar a 0
 
end

to setup-citizens
  create-citizens 300 [
    setxy random-xcor random-ycor                           ; posición aleatoria de los ciudadanos
    set digital-knowledge random-float 40                   ; conocimiento digital aleatorio de los ciudadanos entre 0 y 40 (sobre 100)
    set victim false                                        ; no hay victimas al inicio
    set exposure 0                                          ; no hay exposición al inicio
    set had-attempt-this-tick false                         ; nuevo parámetro que preguntará si hubo intento o no al ciudadano en ese tick                           
    set shape "person"                                      ; definimos a los ciudadanos con el icono de personas
    set size 1                                              ; tamaño del icono de personas
    recolor                                                 ; pintamos a todos los ciudadanos con escalas de verdes en función de su conocimiento digital
  ]
end

to setup-attackers
  create-attackers n-attackers [
    setxy random-xcor random-ycor                           ; posición aleatoria de los atacantes
    set effort 0.5                                          ; esfuerzo de intensidad intermedia
    set attempts 0                                          ; no hay intentos de ataque al inicio 
    set successes 0                                         ; no hay exitos al inicio
    set last-payoff 0                                       ; no hay beneficio al inicio
    set aspiration-payoff 0                                 ; aspiración inicial neutra, ni gana ni pierde
    set payoff-prev 0                                       ; no hay beneficio previo al inicio
    set jail-until 0                                        ; ningun atacante está encarcelado de inicio
    set shape "bug"                                         ; definimos a los atacantes con el icono de bicho
    set size 1.2                                            ; tamaño del icono de personas
    set color red                                           ; pintamos a todos los atacantes de rojo
  ]
end

to go
   set total-victims 0
   ask citizens [
    set victim false
    set had-attempt-this-tick false
    decay-digital-knowledge                                ; olvido para todos los ciudadanos
  ]
  attackers-act                                            ; nuevo procedimiento de ataque endogeno                            
  ask citizens [recolor]
  tick
  
  let r 0
  if attempts-per-tick > 0 [
    set r total-victims / attempts-per-tick
  ]
  set ema-success-rate ((1 - ema-alpha) * ema-success-rate + ema-alpha * r)
end

to attempt-fraud-new [target new-base-risk]                ; evalua un intento de fraude sobre target usando un riesgo base efectivo
    ask target [
    set had-attempt-this-tick true                         ; hubo intento en este tick
    set exposure exposure + 1                              ; aumenta la exposición
      
    let knowledge-factor digital-knowledge / 100                 ; normalizamos el conocimiento digital de 0 a 1
    let p-fall range01 (new-base-risk * (1 - knowledge-factor))  ; calcula la probabilidad de caer con el nuevo riesgo base efectivo

    ifelse random-float 1 < p-fall [                       ; cae en fraude, se marca como victima, aumenta contadores y el aprendizaje es alto
     set victim true
     set total-victims total-victims + 1
     set cumulative-victims cumulative-victims + 1
     learn-from-failure
][                                                         ; detecta el fraude, aprendizaje bajo por detección
  learn-from-detection                                     
  ]
]
end

to learn-from-detection
  set digital-knowledge range100 (digital-knowledge + experience-gain-small)
end

to learn-from-failure
  set digital-knowledge range100 (digital-knowledge + experience-gain-large)
end

to decay-digital-knowledge      ; olvido
    if not victim [
    set digital-knowledge range100 (digital-knowledge - decay-rate)
  ]
end

to attackers-act
  set attempts-per-tick 0
  set success-per-tick 0
  ask attackers [
    set attempts 0
    set successes 0
    set effort max list effort 0.05
    set last-payoff 0  
  ]
  ask attackers with [ticks >= jail-until][                    ; actua solo si no está en la carcel, solo atacantes no pillados por la policía
    set attempts 0                                             ; traduce la intensidad de los ataques a un numero de intento concreto topado por el valor máximo
    repeat max-attempts-per-attacker [
      if random-float 1 < effort [set attempts attempts + 1]
    ]  
    set attempts-per-tick attempts-per-tick + attempts        ; aumenta los intentos por tick
    repeat attempts [         ;bucle de intentos
      let target one-of citizens             ;elige victimas aleatorias (no incorpora selección de victima aún)
      if target != nobody [
        attempt-fraud-new target base-risk
        if [victim] of target [              ; si el ciudadano fue victima aumenta el éxito del atacante y del sistema
          set successes successes + 1
          set success-per-tick success-per-tick + 1
          police-act                     ; intervención policial probabilítica
        ]
      ]
    ]
    set last-payoff (successes * base-payoff-per-success) - (attempts * cost-per-attempt)                                    ; beneficio neto simple del tick: beneficio por éxito menos coste por intento 
    let aspiration-alpha 0.1                                                                                                 ; velocidad de actualización de la aspiración
    let aspiration-drift 0.01                                                                                                ; para que la aspiración suba un poco
    set aspiration-payoff aspiration-payoff + aspiration-alpha * (payoff-prev - aspiration-payoff) + aspiration-drift
    ifelse payoff-prev > aspiration-payoff [                                                                                 ; Aprendizaje del attacker si le va bien (beneficio positivo) sube la intensidad del ataque (effort), si no, la baja
      set effort range01 (effort + attacker-learning-rate)
      set aspiration-payoff aspiration-payoff + 0.01 * (last-payoff - aspiration-payoff)
    ][
      set effort range01 (effort - attacker-learning-rate)
    ]
    set payoff-prev last-payoff
  ]
end

to awareness-citizens
  ask citizens [
      let gain learning-quality * awareness-intensity * (100 - digital-knowledge)     ; gain es la ganancia por sensibilización, modulada por la calidad, un multiplicador de intensidad y el conocimiento digital previo
      set digital-knowledge range100 (digital-knowledge + gain)
    ]
end

to awareness-citizens-periodic
  if ticks > 0 and ticks mod awareness-frecuency = 0 [
  awareness-citizens
]
end

to train-selected
  let n-trainees round (training-shares * count citizens)
  let trainees n-of n-trainees citizens
  ask trainees [
     let gain learning-quality * training-intensity * (100 - digital-knowledge)       ; gain es la ganancia por formación, modulada por la calidad, un multiplicador de intensidad y el conocimiento digital previo
     set digital-knowledge range100 (digital-knowledge + gain)
  ]
end

to train-selected-periodic
  if ticks > 0 and ticks mod train-frecuency = 0 [
  train-selected
]
end
to police-act                                                                        ; se ejecutará dentro del procedimiento de los atacantes por lo que se preguntará allí.
  if ticks < jail-until [stop]
  if random-float 1 < p-detection [
    set jail-until ticks + jail-time
  ]
end
    
to-report range01 [x]
  report max list 0 (min list 1 x)
end

to-report range100 [x]
  report max list 0 (min list 100 x)
end

to-report vulnerability-index
  report count citizens with [digital-knowledge < 20] / count citizens
end

to-report expert-index
  report count citizens with [digital-knowledge > 70] / count citizens
end

to-report attackers-jail
  report count attackers with [ticks < jail-until]
end

to-report attackers-free
  report count attackers with [ticks >= jail-until]
end

to recolor
  set color scale-color green digital-knowledge 0 100
end

]]></code>
  <widgets>
    <view x="330" wrappingAllowedX="true" y="65" frameRate="30.0" minPycor="-16" height="479" showTickCounter="true" patchSize="14.4" fontSize="10" wrappingAllowedY="true" width="479" tickCounterLabel="ticks" maxPycor="16" updateMode="1" maxPxcor="16" minPxcor="-16"></view>
    <button x="215" y="50" height="40" disableUntilTicks="false" forever="true" kind="Observer" width="75">go</button>
    <button x="133" y="50" height="40" disableUntilTicks="false" forever="false" kind="Observer" width="70">go
</button>
    <slider x="40" step="1" y="105" max="70" width="250" display="n-attackers" height="50" min="20" direction="Horizontal" default="40.0" variable="n-attackers"></slider>
    <slider x="40" step="1" y="170" max="10" width="250" display="max-attempts-per-attacker" height="50" min="0" direction="Horizontal" default="6.0" variable="max-attempts-per-attacker"></slider>
    <slider x="40" step="0.01" y="240" max="0.3" width="250" display="attacker-learning-rate" height="50" min="0" direction="Horizontal" default="0.05" variable="attacker-learning-rate"></slider>
    <plot x="850" autoPlotX="true" yMax="10.0" autoPlotY="true" y="35" xMin="0.0" height="175" legend="false" xMax="10.0" yMin="0.0" width="245" display="Intentos por ticks">
      <setup></setup>
      <update></update>
      <pen interval="1.0" mode="0" display="default" color="-16777216" legend="true">
        <setup></setup>
        <update>plot attempts-per-tick</update>
      </pen>
    </plot>
    <plot x="1110" autoPlotX="true" yMax="10.0" autoPlotY="true" y="35" xMin="0.0" height="175" legend="false" xMax="10.0" yMin="0.0" width="245" display="Victimas en cada tick">
      <setup></setup>
      <update></update>
      <pen interval="1.0" mode="0" display="default" color="-16777216" legend="true">
        <setup></setup>
        <update>plot ifelse-value (ticks = 0)
[ 0 ][ cumulative-victims / ticks ]</update>
      </pen>
    </plot>
    <plot x="850" autoPlotX="true" yMax="10.0" autoPlotY="true" yAxis="Con.dig.medio" y="225" xMin="0.0" height="340" legend="false" xMax="10.0" yMin="0.0" width="440" xAxis="ticks" display="Conocimiento digital medio">
      <setup></setup>
      <update></update>
      <pen interval="1.0" mode="0" display="default" color="-955883" legend="true">
        <setup></setup>
        <update>plot mean [digital-knowledge] of citizens</update>
      </pen>
    </plot>
    <plot x="1300" autoPlotX="true" yMax="1.0" autoPlotY="true" y="225" xMin="0.0" height="165" legend="false" xMax="10.0" yMin="0.0" width="210" display="Índice de vulnerabilidad">
      <setup></setup>
      <update></update>
      <pen interval="1.0" mode="0" display="default" color="-16777216" legend="true">
        <setup></setup>
        <update><![CDATA[plot (count citizens with [digital-knowledge < 20] / count citizens)]]></update>
      </pen>
    </plot>
    <plot x="1300" autoPlotX="true" yMax="1.0" autoPlotY="true" y="400" xMin="0.0" height="165" legend="false" xMax="10.0" yMin="0.0" width="210" display="Índice de expertos">
      <setup></setup>
      <update></update>
      <pen interval="1.0" mode="0" display="default" color="-16777216" legend="true">
        <setup></setup>
        <update><![CDATA[plot (count citizens with [digital-knowledge > 70] / count citizens)]]></update>
      </pen>
    </plot>
    <button x="300" y="555" height="40" disableUntilTicks="false" forever="false" kind="Observer" width="125" display="Formación Selectiva">train-selected</button>
    <button x="500" y="20" height="40" disableUntilTicks="false" forever="false" kind="Observer" width="66" display="Tri-color"><![CDATA[ask citizens [
    ifelse digital-knowledge < 20 
    [set color grey]
    [ifelse digital-knowledge < 70 
      [set color yellow]
      [set color green] ]
      ]]]></button>
    <button x="585" y="20" height="40" disableUntilTicks="false" forever="false" kind="Observer" width="60" display="Recolor">ask citizens
[ set color scale-color green digital-knowledge 0 100]</button>
    <button x="142" y="558" height="40" disableUntilTicks="false" forever="true" kind="Observer" width="150" display="Sensibilización periódica">awareness-citizens-periodic</button>
    <plot x="850" autoPlotX="true" yMax="0.2" autoPlotY="true" y="570" xMin="0.0" height="175" legend="false" xMax="10.0" yMin="-0.2" width="230" display="Beneficio por intento">
      <setup></setup>
      <update></update>
      <pen interval="1.0" mode="0" display="default" color="-16777216" legend="true">
        <setup></setup>
        <update><![CDATA[plot (ifelse-value (attempts-per-tick > 0) 
[ sum [last-payoff] of attackers / attempts-per-tick] 
[0])]]></update>
      </pen>
    </plot>
    <plot x="1090" autoPlotX="true" yMax="0.2" autoPlotY="true" y="570" xMin="0.0" height="175" legend="false" xMax="10.0" yMin="-0.2" width="230" display="Payoff vs Aspiration">
      <setup></setup>

      </pen>
    </plot>
    <monitor x="1570" precision="4" y="635" height="46" fontSize="11" display="% attackers encarcelados" width="166" sizeVersion="0"><![CDATA[100 * (count attackers with [ticks < jail-until]) / count attackers]]></monitor>
    <slider x="600" step="0.01" y="610" max="0.3" width="215" display="p-detection" height="50" min="0" direction="Horizontal" default="0.05" variable="p-detection"></slider>
    <slider x="600" step="1" y="666" max="1000" width="215" display="jail-time" height="50" min="0" direction="Horizontal" default="100.0" variable="jail-time"></slider>
    <button x="435" y="556" height="40" disableUntilTicks="false" forever="true" kind="Observer" width="150" display="Formación periódica">train-selected-periodic</button>
    <button x="600" y="558" height="40" disableUntilTicks="false" forever="false" kind="Observer" width="105" display="Redada Policial">ask attackers [
    set p-detection 0.2
    police-act]</button>
    <button x="709" y="558" height="40" disableUntilTicks="false" forever="false" kind="Observer" width="105" display="Fin Redada">ask attackers [
    set p-detection 0.05
    police-act]</button>
    <slider x="300" step="0.01" y="610" max="1" width="285" display="training-shares" height="50" min="0" direction="Horizontal" default="0.2" variable="training-shares"></slider>
    <slider x="300" step="100" y="669" max="3000" width="280" display="train-frecuency" height="50" min="100" direction="Horizontal" default="1000.0" variable="train-frecuency"></slider>
    <slider x="40" step="0.01" y="305" max="1" width="250" display="base-risk" height="50" min="0" direction="Horizontal" default="0.2" variable="base-risk"></slider>
    <slider x="40" step="0.01" y="370" max="1" width="250" display="decay-rate" height="50" min="0" direction="Horizontal" default="0.05" variable="decay-rate"></slider>
    <slider x="40" step="100" y="612" max="3000" width="251" display="awareness-frecuency" height="50" min="1" direction="Horizontal" default="1000.0" variable="awareness-frecuency"></slider>
    <button x="45" y="50" height="40" disableUntilTicks="false" forever="false" kind="Observer" width="75">setup
</button>
    <monitor x="1625" precision="17" y="85" height="45" fontSize="11" display="Victimas en cada tick" width="140" sizeVersion="0">total-victims</monitor>
    <monitor x="1625" precision="17" y="35" height="45" fontSize="11" display="Intentos por tick" width="140" sizeVersion="0">attempts-per-tick</monitor>
    <monitor x="1625" precision="4" y="135" height="45" fontSize="11" display="Media Victimas por tick" width="140" sizeVersion="0">cumulative-victims / ticks</monitor>
    <plot x="1365" autoPlotX="true" yMax="10.0" autoPlotY="true" y="35" xMin="0.0" height="175" legend="false" xMax="10.0" yMin="0.0" width="240" display="Victimas acumuladas">
      <setup></setup>
      <update></update>
      <pen interval="1.0" mode="0" display="default" color="-16777216" legend="true">
        <setup></setup>
        <update>plot cumulative-victims</update>
      </pen>
    </plot>
    <monitor x="1580" precision="4" y="505" height="46" fontSize="11" display="Tasa éxito ataque" width="136" sizeVersion="0">ema-success-rate</monitor>
    <monitor x="1580" precision="4" y="455" height="46" fontSize="11" display="Tasa éxito ataque (acc)" width="136" sizeVersion="0">cumulative-victims / (sum [exposure] of citizens)</monitor>
    <plot x="1520" autoPlotX="true" yMax="0.2" autoPlotY="true" y="260" xMin="0.0" height="190" legend="false" xMax="10.0" yMin="0.0" width="240" display="Tasa de éxito">
      <setup></setup>

        <setup></setup>
        <update>plot mean [aspiration-payoff] of attackers</update>
      </pen>
    </plot>
    <plot x="1329" autoPlotX="true" yMax="10.0" autoPlotY="true" y="570" xMin="0.0" height="175" legend="false" xMax="10.0" yMin="0.0" width="230" display="Atacantes encarcelados vs activos">
      <setup></setup>
